[Unit]
Description=FactoryIO replacement Modbus/TCP simulator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=otlab
Group=otlab
WorkingDirectory=/opt/factoryio
ExecStart=/usr/bin/python3 /opt/factoryio/factoryio_simulator.py --host 0.0.0.0 --port 502 --unit-id 1 --headless
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
