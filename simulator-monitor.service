[Unit]
Description=Read-only FactoryIO simulator HMI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kali
Group=kali
WorkingDirectory=/opt/factoryio
ExecStart=/usr/bin/python3 /opt/factoryio/simulator_monitor.py --host 10.77.20.10 --port 502 --unit-id 1 --web-host 127.0.0.1 --web-port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
